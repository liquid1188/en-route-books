<a class="book" href="/books/{{ b.slug }}/"><img src="{{ b.cover }}" alt="" onerror="this.onerror=null;this.src='/images/cover-coming-soon.jpg'" loading="lazy" width="400" height="600">{% if b.award %}<span class="ribbon">Award winner</span>{% endif %}<h3>{{ b.title }}</h3>{% if b.author %}<p>{{ b.author }}</p>{% endif %}</a>