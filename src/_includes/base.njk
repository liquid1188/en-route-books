<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or 'A Catholic publishing house in St. Louis. Nearly 700 titles in theology, philosophy, spirituality, literature, poetry, and children\'s books since 2014.' }}">
  {% if site.setupMode %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400&family=Karla:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v={{ buildId }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:image" content="{{ ogImage or (site.url ~ '/images/crest-512.png') }}">
</head>
<body{% if page.url == "/" %} class="home"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head">
  <div class="wrap bar">
    <a class="brand" href="/"><img src="/images/wordmark-white.png" alt="En Route Books and Media. Make the time." width="1707" height="355"></a>
    <input type="checkbox" id="menu" class="menu-toggle" aria-label="Open menu">
    <label for="menu" class="menu-btn"><span></span><span></span></label>
    <nav class="nav" aria-label="Main">
      <a href="/books/"{% if '/books' in page.url or '/category' in page.url %} aria-current="page"{% endif %}>Books</a>
      <a href="/awards/"{% if page.url == '/awards/' %} aria-current="page"{% endif %}>Awards</a>
      <a href="/authors/"{% if '/authors' in page.url %} aria-current="page"{% endif %}>Authors</a>
      <a href="/radio/"{% if page.url == '/radio/' %} aria-current="page"{% endif %}>WCAT Radio</a>
      <a href="/free/"{% if page.url == '/free/' %} aria-current="page"{% endif %}>Free</a>
      <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
      <a href="/wholesale/"{% if page.url == '/wholesale/' %} aria-current="page"{% endif %}>Wholesale</a>
      <form class="nav-search" action="/books/" method="get" role="search"><input type="search" name="q" placeholder="Search books" aria-label="Search books"></form>
      <a class="btn small" href="/submissions/">Submit a manuscript</a>
    </nav>
  </div>
</header>
<main id="main">{{ content | safe }}</main>
<footer class="site-foot v2">
  <div class="wrap foot-top">
    <div class="fbrand">
      <img class="fmark" src="/images/crest-white.png" alt="" width="512" height="637" loading="lazy"><p class="foot-brand">En Route Books and Media</p>
      <p class="foot-motto">Make the time.</p>
      <p class="foot-tag">A Catholic publishing house in St. Louis, Missouri, founded in 2014 by Dr. Ronda Chervin and Dr. Sebastian Mahfood, OP.</p>
      <div class="foot-ctas"><a class="btn" href="/submissions/">Submit a manuscript</a><a class="btn ghost" href="/wholesale/">Wholesale orders</a></div>
    </div>
    <div class="fcol"><h3>Read</h3><a href="/books/">All books</a><a href="/authors/">Authors</a><a href="/free/">Free downloads</a><a href="/radio/">WCAT Radio and TV</a></div><div class="fcol"><h3>The house</h3><a href="/about/">About En Route</a><a href="/submissions/">Submissions</a><a href="/wholesale/">Wholesale and bulk orders</a><a href="/contact/">Contact</a></div>
    <div class="fcol fcontact">
      <h3>Contact</h3>
      <a class="crow" href="mailto:{{ site.email }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M3 6h18v12H3z"/><path fill="none" stroke="currentColor" stroke-width="1.7" d="m3 7 9 6 9-6"/></svg><span>{{ site.email }}</span></a><a class="crow" href="tel:3147061009"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M6 3h4l2 5-2.5 1.5a11 11 0 0 0 5 5L16 12l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2z"/></svg><span>{{ site.phone }}</span></a><span class="crow"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.7"/></svg><span>{{ site.city }}</span></span>
      <div class="socials"><a class="soc" href="{{ site.wcattv }}" aria-label="WCAT TV on YouTube" title="WCAT TV on YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M3 8.5C3 6.6 4.5 5 6.4 5h11.2C19.5 5 21 6.6 21 8.5v7c0 1.9-1.5 3.5-3.4 3.5H6.4C4.5 19 3 17.4 3 15.5z"/><path fill="currentColor" d="m10 9 5 3-5 3z"/></svg></a></div>
    </div>
  </div>
  <div class="wrap foot-news">
    <div><p class="foot-brand">Hear about new titles.</p><p class="foot-tag">A short note when something worth reading comes out.</p></div>
    <form class="news-form" action="https://enroutebooksandmedia.us17.list-manage.com/subscribe/post?u=d20c088b919959327cd23b128&amp;id=91e11833c4&amp;f_id=005edfe3f0" method="post" target="_blank"><label class="sr" for="mc-email">Email</label><input id="mc-email" type="email" name="EMAIL" placeholder="you@example.com" required><input type="text" name="b_d20c088b919959327cd23b128_91e11833c4" tabindex="-1" value="" style="position:absolute;left:-5000px" aria-hidden="true"><button class="btn" type="submit">Subscribe</button></form>
  </div>
  <div class="wrap foot-bottom">
    <span class="copy">&copy; {{ today | year }} En Route Books and Media, LLC. Member, Association of Catholic Publishers.</span>
    <span class="util"><a href="/admin/">Sign in</a><a href="https://lickitysplitweb.com">Site by Lickity Split Web Design</a><a class="totop" href="#top" onclick="window.scrollTo({top:0,behavior:'smooth'});return false" aria-label="Back to top"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="m6 14 6-6 6 6"/></svg></a></span>
  </div>
</footer>
</body>
</html>
