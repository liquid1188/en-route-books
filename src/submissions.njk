---
layout: base.njk
title: Submissions
permalink: /submissions/
---
<div class="wrap page-head"><h1>Submit a manuscript</h1><p class="lede">{{ submissions.lede }}</p></div>
<section class="band" style="padding-top:1.5rem">
  <div class="wrap two-col top">
    <div class="prose">
      {%- for sec in submissions.sections %}
      <h2>{{ sec.heading }}</h2>
      {{ sec.text | md | safe }}
      {%- endfor %}
      <p>Send your manuscript to <a href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
    </div>
    <div>
      <div class="steps" style="grid-template-columns:1fr;gap:1.4rem">
        {%- for st in submissions.steps %}<div><h3>{{ st.title }}</h3><p>{{ st.text | safe }}</p></div>
        {%- endfor %}
      </div>
      <p style="margin-top:1.5rem"><a class="btn" href="mailto:{{ site.email }}?subject=Manuscript%20submission">Email your manuscript</a></p>
    </div>
  </div>
</section>
