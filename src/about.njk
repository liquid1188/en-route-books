---
layout: base.njk
title: About
permalink: /about/
---
<div class="wrap page-head"><h1>About En Route</h1><p class="lede">{{ about.lede }}</p></div>
<section class="band" style="padding-top:1.5rem">
  <div class="wrap two-col top">
    <div class="prose">
      {{ about.body | md | safe }}
      <figure class="crest-fig"><img src="/images/crest.png" alt="The En Route crest: a ship under a Chi-Rho sail, flying the papal flag, over an open book" width="781" height="972" loading="lazy"><figcaption>{{ about.crestCaption }}</figcaption></figure>
    </div>
    <div>
      <div class="facts" style="max-width:320px">
        <dl>
          {%- for f in about.facts %}<dt>{{ f.label }}</dt><dd>{{ f.value }}</dd>{% endfor %}
        </dl>
      </div>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="band-head"><h2>Founders</h2></div>
    <div class="founders">
      {%- for f in about.founders %}
      <div class="founder">
        <img src="{{ f.photo }}" alt="{{ f.name }}" loading="lazy">
        <div>
          <h3>{{ f.name }}</h3>
          <p class="kicker">{{ f.role }}</p>
          {{ f.bio | md | safe }}
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

