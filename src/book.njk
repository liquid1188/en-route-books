---
layout: base.njk
pagination:
  data: books
  size: 1
  alias: b
permalink: "/books/{{ b.slug }}/"
eleventyComputed:
  title: "{{ b.title }}{% if b.author %} by {{ b.author }}{% endif %}"
  description: "{{ b.desc[0] | default(b.title) | truncate(155) }}"
  ogImage: "{{ b.cover }}"
---
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Book","name":{{ b.title | dump | safe }},{% if b.author %}"author":{"@type":"Person","name":{{ b.author | dump | safe }}},{% endif %}"publisher":{"@type":"Organization","name":"En Route Books and Media"},"image":{{ b.cover | dump | safe }}}</script>
<section class="band" style="padding-top:2rem">
  <div class="wrap book-page">
    <div class="side">
      <img class="cover" onerror="this.onerror=null;this.src='/images/cover-coming-soon.jpg'" src="{{ b.cover }}" alt="Cover of {{ b.title }}" width="400" height="600">
      <div class="buy">
        {% if b.price and "TBA" not in b.price %}<p>{{ b.price }}</p>{% endif %}
        {% if b.formats.length %}<div class="formats">{% for f in b.formats %}<a class="btn{% if not loop.first %} ghost{% endif %}" href="{{ f.url }}">{{ f.label }}</a>{% endfor %}</div>{% else %}<a class="btn ghost" href="{{ b.url }}">View on En Route</a>{% endif %}
        <p style="margin:.8rem 0 0;font-size:.88rem;color:var(--ink-2)">Bookstores, parishes, and groups: <a href="/wholesale/">bulk orders direct from En Route</a>.</p>
      </div>
    </div>
    <div>
      <p class="kicker crumbs"><a href="/books/">Books</a>{% for c in b.cats %} · <a href="/category/{{ c | slugify2 }}/">{{ c }}</a>{% endfor %}</p>
      <h1>{{ b.title }}</h1>
      {% if b.award %}<p class="award-line">{{ b.award }}</p>{% endif %}
      {% if b.author %}<p class="byline">by <a href="/authors/{{ b.authorSlug }}/">{{ b.author }}</a></p>{% endif %}
      <div class="prose">{% for p in b.desc %}<p>{{ p }}</p>{% endfor %}</div>
      {% if b.about %}<div class="endorse"><h3>About the author</h3>{% for p in b.about %}<p>{{ p }}</p>{% endfor %}</div>{% endif %}
      {% if b.praise.length %}<div class="endorse"><h3>Praise</h3>{% for p in b.praise %}<blockquote><p>{{ p.q }}</p>{% if p.by %}<cite>{{ p.by }}</cite>{% endif %}</blockquote>{% endfor %}</div>{% endif %}
    </div>
  </div>
</section>
{%- set more = [] %}{% for o in books %}{% if o.slug != b.slug and b.author and o.author == b.author %}{% set more = (more.push(o), more) %}{% endif %}{% endfor %}
{%- if more.length %}
<section class="band ivory-2">
  <div class="wrap">
    <div class="band-head"><h2>Also by {{ b.author }}</h2><a class="textlink" href="/authors/{{ b.authorSlug }}/">All {{ more.length + 1 }} titles →</a></div>
    <div class="books">{% for o in more.slice(0, 6) %}{% set b = o %}{% include "bookcard.njk" %}{% endfor %}</div>
  </div>
</section>
{%- endif %}
{%- set rel = [] %}{% if b.cats.length %}{% for o in books %}{% if o.slug != b.slug and o.author != b.author and b.cats[0] in o.cats and rel.length < 6 %}{% set rel = (rel.push(o), rel) %}{% endif %}{% endfor %}{% endif %}
{%- if rel.length %}
<section class="band">
  <div class="wrap">
    <div class="band-head"><h2>More in {{ b.cats[0] }}</h2><a class="textlink" href="/category/{{ b.cats[0] | slugify2 }}/">Browse the subject →</a></div>
    <div class="books">{% for o in rel %}{% set b = o %}{% include "bookcard.njk" %}{% endfor %}</div>
  </div>
</section>
{%- endif %}
